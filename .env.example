NODE_ENV=production

# Railway provides PORT automatically. Locally, the app defaults to 5000.
# PORT=5000

# SQLite persistence. On Railway, mount a volume at /data and set:
# DATABASE_PATH=/data/data.db
DATABASE_PATH=./data.db

# Optional AI stylist. Leave unset to use the built-in rules engine.
# AI_PROVIDER=auto        # auto | openai | anthropic
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
